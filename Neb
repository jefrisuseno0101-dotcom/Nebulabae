<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nebulabae</title>
<style>
  body{font-family:sans-serif;text-align:center;padding:60px 20px}
  a{display:inline-block;background:#76d013;color:#fff;font-weight:bold;
    padding:16px 32px;border-radius:40px;text-decoration:none}
</style>
</head>
<body>
<p>Membuka halaman dukungan...</p>
<a id="btn" href="https://sociabuzz.com/nebulabae/tribe">Buka di Chrome</a>
<script>
  var tujuan = "sociabuzz.com/nebulabae/tribe";
  var ua = navigator.userAgent;
  var diTikTok = /musical_ly|Bytedance|TikTok/i.test(ua);
  var intent = "intent://" + tujuan +
    "#Intent;scheme=https;package=com.android.chrome;" +
    "S.browser_fallback_url=" + encodeURIComponent("https://" + tujuan) + ";end";

  if (/Android/i.test(ua) && diTikTok) {
    document.getElementById("btn").href = intent;
    location.href = intent;
  } else if (!diTikTok) {
    location.replace("https://" + tujuan);
  }
</script>
</body>
</html>
